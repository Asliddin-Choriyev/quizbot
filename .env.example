# =========================================================
# TELEGRAM QUIZ BOT - CONFIGURATION ENVIRONMENT
# =========================================================

# Your Telegram Bot Token obtained from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ1234567

# Comma-separated list of Telegram User IDs for Bot Administrators
# Get your ID from @userinfobot or @rawdatabot
ADMIN_IDS=123456789,987654321

# Default user interface language: 'uz' (Uzbek) or 'en' (English)
DEFAULT_LANGUAGE=uz

# Database path (defaults to data/quizbot.db)
DB_PATH=data/quizbot.db

# Default timer per question in seconds (10, 15, 20, 30, 45, 60)
DEFAULT_TIMER=30

# Maximum allowed rows per Excel/CSV import
MAX_IMPORT_ROWS=50000

# Maximum uploaded file size in Megabytes
MAX_FILE_SIZE_MB=50
